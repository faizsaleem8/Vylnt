# Run npm run setup:local to generate an ignored .env with a random local API token.
VYNLT_STORAGE=local
VYNLT_API_TOKEN=replace-with-a-random-token-at-least-32-characters
HOST=127.0.0.1
PORT=4318
VYNLT_DATA_FILE=.local/scans.json
# Supabase mode: apply supabase/migrations/001_initial.sql first.
# VYNLT_STORAGE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# SUPABASE_ANON_KEY is also supported for legacy anon keys.
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY aliases are accepted.
# VYNLT_ALLOWED_ORIGINS=https://your-dashboard.example
# API limits per process; all default to a 60-second window. Zero does not disable them.
# VYNLT_RATE_WINDOW_MS=60000
# VYNLT_RATE_IP_MAX=600
# VYNLT_RATE_USER_MAX=300
# VYNLT_RATE_WRITE_MAX=60
# Forwarded client IP headers are not trusted. Behind a proxy, the socket limit is shared.
# Enforce per-client and distributed limits at your trusted gateway before public deployment.
