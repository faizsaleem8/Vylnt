# Run npm run setup:local to generate an ignored .env with a random local API token.
VYLNT_STORAGE=local
VYLNT_API_TOKEN=replace-with-a-random-token-at-least-32-characters
HOST=127.0.0.1
PORT=4318
VYLNT_DATA_FILE=.local/scans.json
# Optional local blockchain (run chain:node, chain:compile, chain:deploy first):
VYLNT_BLOCKCHAIN=off
# Set VYLNT_BLOCKCHAIN=local to automatically anchor saved insights.
# Supabase mode: apply supabase/migrations/001_initial.sql first.
# VYLNT_STORAGE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# SUPABASE_ANON_KEY is also supported for legacy anon keys.
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY aliases are accepted.
# VYLNT_ALLOWED_ORIGINS=https://your-dashboard.example
# API limits per process; all default to a 60-second window. Zero does not disable them.
# VYLNT_RATE_WINDOW_MS=60000
# VYLNT_RATE_IP_MAX=600
# VYLNT_RATE_USER_MAX=300
# VYLNT_RATE_WRITE_MAX=60
# Local defaults use in-memory counters and ignore forwarded headers.
# Shared production counters (same URL, namespace, secret, window and limits on every replica):
# VYLNT_RATE_STORE=redis
# VYLNT_REDIS_URL=rediss://user:password@redis.example:6379/0
# VYLNT_RATE_KEY_SECRET=replace-with-a-random-secret-at-least-32-characters
# VYLNT_RATE_NAMESPACE=vylnt-production
# Explicit trusted ingress addresses only; never trust arbitrary forwarding headers:
# VYLNT_TRUSTED_PROXIES=10.20.0.2/32
# NODE_ENV=production requires Redis, Supabase and explicit HTTPS origins.
