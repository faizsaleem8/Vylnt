{
  "name": "vynlt",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && vite build --config apps/dashboard/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "lab": "node labs/server.mjs",
    "dev": "node --env-file=.env dist/server/index.js",
    "dev:dashboard": "vite --config apps/dashboard/vite.config.ts",
    "scan:ci": "node dist/cli/index.js",
    "test:browser": "node scripts/browser-tests.mjs",
    "test:auth-browser": "node scripts/auth-browser-tests.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "setup:browser": "node scripts/install-browser.mjs",
    "lab:tls": "node scripts/setup-tls.mjs",
    "check:supabase": "node --env-file=.env scripts/check-supabase.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/chrome": "^0.1.24",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.25.0",
    "playwright": "^1.64.1",
    "supertest": "^7.3.1",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
