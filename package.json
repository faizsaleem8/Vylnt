{
  "name": "vylnt",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "overrides": { "solc": { "tmp": "0.2.7" } },
  "scripts": {
    "gate": "node dist/cli/gate.js",
    "gate:install-hook": "node dist/cli/gate.js --install-hook",
    "gate:uninstall-hook": "node dist/cli/gate.js --uninstall-hook",
    "test:gate": "node scripts/gate-acceptance.mjs",
    "chain:node": "node scripts/blockchain.mjs node",
    "chain:compile": "node scripts/blockchain.mjs compile",
    "chain:deploy": "node scripts/blockchain.mjs deploy",
    "chain:verify": "node scripts/blockchain.mjs verify",
    "test:chain": "node scripts/blockchain-acceptance.mjs",
    "build": "node scripts/build.mjs && vite build --config apps/dashboard/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "lab": "node labs/server.mjs",
    "lab:m1": "node scripts/scanner-manual.mjs",
    "dev": "node --env-file=.env dist/server/index.js",
    "dev:dashboard": "vite --config apps/dashboard/vite.config.ts",
    "scan:ci": "node dist/cli/index.js",
    "ml:prepare": "node scripts/ml-prepare.mjs",
    "ml:prepare:insights": "node scripts/ml-prepare-insights.mjs",
    "ml:controlled": "node scripts/ml-controlled-suite.mjs",
    "ml:applications:fetch": "node scripts/ml-fetch-applications.mjs",
    "ml:applications": "node scripts/ml-application-corpus.mjs",
    "ml:insights": "python ml/insights.py",
    "ml:insights:v3": "python ml/insights_v3.py",
    "ml:verify:candidate": "node scripts/ml-verify-candidate.mjs",
    "ml:release:insights": "node scripts/ml-release-insights.mjs",
    "ml:release:experimental": "node scripts/ml-release-experimental.mjs",
    "ml:review": "node scripts/ml-review.mjs",
    "ml:demo": "node scripts/ml-demo.mjs",
    "ml:demo:lstm": "node scripts/ml-demo.mjs --lstm",
    "ml:train:lstm": "python ml/lstm.py",
    "ml:train": "python ml/baseline.py",
    "ml:bundle": "node scripts/ml-bundle.mjs",
    "test:ml": "python -m unittest discover -s ml/tests",
    "test:ml-worker": "node scripts/insights-worker-tests.mjs",
    "test:ml-report": "node scripts/ml-experimental-report-tests.mjs",
    "test:browser": "node scripts/browser-tests.mjs",
    "test:scanner": "node scripts/scanner-acceptance.mjs",
    "test:pdf": "node scripts/pdf-tests.mjs",
    "test:pdf-ua": "node scripts/check-pdf-ua.mjs",
    "test:ui": "node scripts/ui-audit.mjs",
    "benchmark:pdf": "node scripts/pdf-benchmark.mjs",
    "benchmark:storage": "node scripts/storage-benchmark.mjs",
    "benchmark:observer": "node scripts/observer-benchmark.mjs",
    "test:auth-browser": "node scripts/auth-browser-tests.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "setup:browser": "node scripts/install-browser.mjs",
    "lab:tls": "node scripts/setup-tls.mjs",
    "check:supabase": "node --env-file=.env scripts/check-supabase.mjs",
    "verify:supabase": "node --env-file=.env scripts/supabase-acceptance.mjs",
    "verify:redis": "node --env-file=.env scripts/redis-acceptance.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.10",
    "@types/chrome": "^0.1.24",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.25.0",
    "hardhat": "3.21.0",
    "solc": "0.8.38",
    "supertest": "^7.3.1",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@redis/client": "^6.3.0",
    "@supabase/supabase-js": "^2.109.0",
    "ethers": "6.17.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.1",
    "rate-limit-redis": "^6.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
